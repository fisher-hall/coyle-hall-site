[
{{- $first := true -}}
{{- range .Site.Pages -}}
  {{- if and (not .Draft) (ne .Type "authors") (ne .Type "tags") (ne .Type "categories") -}}
    {{- if not $first -}},{{- end -}}
    {{- $first = false -}}

    {{- $title := .Title -}}

    {{- /* Build a clean plain-text body. .RawContent/.Content on raw .html pages
           keeps <style>/<script> blocks and unexpanded shortcodes, whose text
           survives plainify, so strip those first, then plainify away remaining
           tags and collapse whitespace. The index must never carry raw markup/CSS
           or the search UI renders a full page preview instead of a snippet. */ -}}
    {{- $raw := .RawContent | default .Content -}}
    {{- $raw = replaceRE `(?is)<style[^>]*>.*?</style>` " " $raw -}}
    {{- $raw = replaceRE `(?is)<script[^>]*>.*?</script>` " " $raw -}}
    {{- $raw = replaceRE `\{\{[<%][^}]*[>%]\}\}` " " $raw -}}
    {{- $clean := $raw | htmlUnescape | plainify -}}
    {{- $clean = replaceRE `\s+` " " $clean -}}
    {{- $clean = trim $clean " " -}}

    {{- /* Always derive the description from cleaned plain text. .Description /
           .Summary can contain raw HTML head matter (<meta>/<link>/<style>). */ -}}
    {{- $description := $clean -}}
    {{- $content := $clean -}}

    {{- if or (eq .Section "hall-staff") (eq .Section "hall-gov") (eq .Section "hall-commissioners") -}}
      {{- $hometown := .Params.params.hometown | default "" -}}
      {{- $major := .Params.params.major | default .Params.params.studying | default "" -}}
      {{- $hobbies := .Params.params.hobbies | default "" -}}
      {{- $favoritepart := .Params.params.favoritepart | default "" -}}
      {{- $section := .Params.params.section | default "" -}}

      {{- $title = printf "%s - %s" .Title (.Params.description | default "") -}}
      {{- $description = printf "%s of Coyle Hall" (.Params.description | default "") -}}

      {{- $contentParts := slice .Title -}}
      {{- if $hometown -}}{{- $contentParts = $contentParts | append (printf "from %s" $hometown) -}}{{- end -}}
      {{- if $major -}}{{- $contentParts = $contentParts | append (printf "Studies %s" $major) -}}{{- end -}}
      {{- if .Params.description -}}{{- $contentParts = $contentParts | append .Params.description -}}{{- end -}}
      {{- if $hobbies -}}{{- $contentParts = $contentParts | append (printf "Hobbies: %s" $hobbies) -}}{{- end -}}
      {{- if $favoritepart -}}{{- $contentParts = $contentParts | append (printf "Favorite part: %s" $favoritepart) -}}{{- end -}}
      {{- if $section -}}{{- $contentParts = $contentParts | append (printf "Section: %s" $section) -}}{{- end -}}
      {{- if $clean -}}{{- $contentParts = $contentParts | append $clean -}}{{- end -}}

      {{- $content = delimit $contentParts ". " -}}
    {{- end -}}

    {
      "title": {{ $title | jsonify }},
      "description": {{ ($description | truncate 200) | jsonify }},
      "url": {{ .RelPermalink | jsonify }},
      "content": {{ ($content | truncate 500) | jsonify }}
    }
  {{- end -}}
{{- end -}}
]
