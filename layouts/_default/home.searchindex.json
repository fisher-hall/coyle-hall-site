{{- /* Client-side search index, fetched by main.js at runtime.

       Two sources feed it:
         1. Every content page.
         2. Every person in data/hall-{staff,gov,commissioners}, who are rendered
            from YAML by their section layout and so are not pages at all. Those
            entries deep-link to the person's card anchor on the section page. */ -}}

{{- $entries := slice -}}

{{- /* ── Content pages ──────────────────────────────────────────── */ -}}
{{- range .Site.Pages -}}
  {{- if and (not .Draft) (ne .Type "authors") (ne .Type "tags") (ne .Type "categories") -}}

    {{- /* Build a clean plain-text body. .RawContent/.Content on raw .html pages
           keeps <style>/<script> blocks and unexpanded shortcodes, whose text
           survives plainify, so strip those first, then plainify away remaining
           tags and collapse whitespace. The index must never carry raw markup/CSS
           or the search UI renders a full page preview instead of a snippet. */ -}}
    {{- $raw := .RawContent | default .Content -}}
    {{- $raw = replaceRE `(?is)<style[^>]*>.*?</style>` " " $raw -}}
    {{- $raw = replaceRE `(?is)<script[^>]*>.*?</script>` " " $raw -}}
    {{- $raw = replaceRE `\{\{[<%][^}]*[>%]\}\}` " " $raw -}}
    {{- $clean := $raw | htmlUnescape | plainify -}}
    {{- $clean = replaceRE `\s+` " " $clean -}}
    {{- $clean = trim $clean " " -}}

    {{- /* Always derive the description from cleaned plain text. .Description /
           .Summary can contain raw HTML head matter (<meta>/<link>/<style>). */ -}}
    {{- $entries = $entries | append (dict
          "title" .Title
          "description" ($clean | truncate 200)
          "url" .RelPermalink
          "content" ($clean | truncate 500)) -}}
  {{- end -}}
{{- end -}}

{{- /* ── People, from the YAML the hall pages render ────────────── */ -}}
{{- with (index hugo.Data "hall-staff" "staff") -}}
  {{- with .rector -}}
    {{- $entries = $entries | append (partials.Include "search/person.html" (dict "person" . "role" "Rector" "url" "/hall-staff/")) -}}
  {{- end -}}
  {{- with .priest -}}
    {{- $entries = $entries | append (partials.Include "search/person.html" (dict "person" . "role" "Priest in Residence" "url" "/hall-staff/")) -}}
  {{- end -}}
  {{- range .members -}}
    {{- $entries = $entries | append (partials.Include "search/person.html" (dict "person" . "url" "/hall-staff/")) -}}
  {{- end -}}
{{- end -}}

{{- range (index hugo.Data "hall-gov" "government").members -}}
  {{- $entries = $entries | append (partials.Include "search/person.html" (dict "person" . "url" "/hall-gov/")) -}}
{{- end -}}

{{- range (index hugo.Data "hall-commissioners" "commissioners").commissioners -}}
  {{- $entries = $entries | append (partials.Include "search/person.html" (dict "person" . "url" "/hall-commissioners/")) -}}
{{- end -}}

[
{{- range $i, $e := $entries -}}
  {{- if $i }},{{ end }}
  {
    "title": {{ $e.title | jsonify }},
    "description": {{ $e.description | jsonify }},
    "url": {{ $e.url | jsonify }},
    "content": {{ ($e.content | truncate 500) | jsonify }}
  }
{{- end -}}
]
